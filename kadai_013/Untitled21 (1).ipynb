      "cell_type": "code",
      "source": [
        "def buy(price, zei):\n",
        "    # 消費税込みの金額を計算する（zeiを税率（例: 10%）として扱う場合）\n",
        "    total = price * (1 + zei / 100)\n",
        "    return total\n",
        "\n",
        "# 関数を呼び出し、引数として購入金額と税率（例: 10%）を渡す\n",
        "total_price = buy(110, 10)\n",
        "print(f\"消費税込みの金額は：{total_price}円です。\")"
      ],
